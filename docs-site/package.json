{
  "name": "wso2-docs-site",
  "private": true,
  "type": "module",
  "description": "WSO2 docs site: content pipeline (fetch, convert) and Docusaurus site.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm test -w @wso2/docs-converter",
    "build:converter": "npm run build -w @wso2/docs-converter",
    "fetch": "node scripts/fetch-sources.mjs",
    "content": "npm run build:converter && node scripts/build-content.mjs",
    "check-source": "npm run build:converter && wso2-docs check",
    "start": "node scripts/docusaurus.mjs start site",
    "start:quick": "node scripts/build-sections.mjs start",
    "build": "node scripts/docusaurus.mjs build site",
    "build:quick": "node scripts/build-sections.mjs build",
    "serve": "docusaurus serve site"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.2.8",
    "@mdx-js/react": "3.1.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "@mui/material": "7.3.4",
    "@wso2/docs-converter": "0.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "js-yaml": "4.3.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
